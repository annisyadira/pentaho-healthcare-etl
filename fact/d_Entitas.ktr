  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>eis</connection>
    <sql>SELECT
    e.[KdProfile] AS [KdProfile_oltp],
    e.[ClientName] AS [ClientName_oltp],
    ISNULL(e.[NoEntitas], '-1') AS [NoEntitas_oltp],
    ISNULL(e.[KdJenisEntitas], '-1') AS [KdJenisEntitas_oltp],
    ISNULL(e.[JenisEntitas], 'Entitas tidak diketahui') AS [JenisEntitas_oltp],
    ISNULL(e.[KdTitle], '-1') AS [KdTitle_oltp],
    ISNULL(CAST(e.[Title] AS VARCHAR(15)), 'Tidak ada title') AS [Title_oltp],
    ISNULL(e.[NamaLengkap], 'Tidak ada nama') AS [NamaLengkap],
    ISNULL(e.[TempatLahir], 'Tidak ada alamat') AS [TempatLahir],
    e.[TglLahir] AS [TglLahir_oltp],
    ISNULL(e.[KdJenisKelamin], '-1') AS [KdJenisKelamin_oltp],
    ISNULL(CAST(e.[JenisKelamin] AS VARCHAR(25)), 'tidak ada jenis kelamin') AS [JenisKelamin_oltp],
    ISNULL(e.[KdAgama], '-1') AS [KdAgama_oltp],
    ISNULL(e.[Agama], 'Tidak ada agama') AS [Agama_oltp],
    ISNULL(e.[KdStatusPerkawinan], '-1') AS [KdStatusPerkawinan_oltp],
    ISNULL(e.[StatusPerkawinan], 'Tidak ada status perkawinan') AS [StatusPerkawinan_oltp],
    ISNULL(e.[KdSuku], '-1') AS [KdSuku_oltp],
    ISNULL(e.[Suku], 'Tidak ada suku') AS [Suku_oltp],
    ISNULL(e.[KdGolonganDarahRh], '-1') AS [KdGolonganDarah_oltp],
    ISNULL(CAST(e.[GolonganDarahRh] AS VARCHAR(25)), 'Tidak ada golongan darah') AS [GolonganDarah_oltp],
    ISNULL(e.[KdPekerjaan], '-1') AS [KdPekerjaan_oltp],
    ISNULL(e.[Pekerjaan], 'Tidak ada pekerjaan') AS [Pekerjaan_oltp],
    ISNULL(e.[KdJabatanStruktural], '-1') AS [KdStruktural_oltp],
    ISNULL(e.[JabatanStruktural], 'Tidak ada jabatan struktural') AS [Struktural_oltp],
    ISNULL(e.[KdJabatanFungsional], '-1') AS [KdFungsional_oltp],
    ISNULL(e.[JabatanFungsional], 'Tidak ada jabatan fungsional') AS [Fungsional_oltp],
    ISNULL(e.[KdPangkat], '-1') AS [KdPangkat_oltp],
    ISNULL(e.[Pangkat], 'Pangkat tidak ada') AS [Pangkat_oltp],
    ISNULL(e.[KdPendidikan], '-1') AS [KdPendidikan_oltp],
    ISNULL(e.[Pendidikan], 'Tidak ada pendidikan') AS [Pendidikan_oltp],
    ISNULL(e.[KdJurusan], '-1') AS [KdJurusan_oltp],
    ISNULL(e.[Jurusan], 'Jurusan tidak ada') AS [Jurusan_oltp],
    ISNULL(pv.[DesaKelurahan], 'Desa / kelurahan tidak diketahui') AS [DesaKelurahan_oltp],
    ISNULL(pv.[Kecamatan], 'Kecamatan tidak diketahui') AS [Kecamatan_oltp],
    ISNULL(pv.[KotaKabupaten], 'Kabupaten tidak diketahui') AS [KotaKabupaten_oltp],
    ISNULL(pv.[Provinsi], 'Provinsi tidak diketahui') AS [Provinsi_oltp],
    ISNULL(e.[KdNegara], '-1') AS [KdNegara_oltp],
    ISNULL(e.[Negara], 'Negara tidak diketahui') AS [Negara_oltp],
    ISNULL(e.[KdKategori], '-1') AS [KdKategoriEntitas_oltp],
    ISNULL(e.[Kategori], 'Kategori tidak diketahui') AS [KategoriEntitas_oltp],
    ISNULL(e.[KdStatus], '-1') AS [KdStatusEntitas_oltp],
    ISNULL(e.[Status], 'Tidak ada status entitas') AS [StatusEntitas_oltp],
	'kondisi pulang' AS [KondisiPulangHead],
	'jenis entitas' AS [JenisEntitasHead],
	'entitas' AS [StatusEntitasHead],
	'keluar' AS [StatusKeluarHead],
    'formal' AS [PendidikanHead],
    'pegawai' AS [PangkatHead],
    'pegawai' AS [GolonganHead],
    'jabatan' AS [KelompokJabatanHead],
    'pasien' AS [KelompokPasienHead],
    'pekerjaan' AS [PekerjaanHead],
    'perkawinan' AS [StatusPerkawinanHead],
    'Jaminan' AS [KelasJaminanHead],
    'Layanan' AS [KelasLayananHead],
    'Kamar' AS [KelasKamarHead],
    'Rujukan' AS [AsalRujukanHead],
	'suku' AS [SukuHead],
    e.[StatusEnabled]
FROM [dbo].[dlentity] e
LEFT JOIN [dbo].[dlpatientvisite] pv
    ON e.[NoEntitas] = pv.[NoEntitas_CM]
   AND e.[KdProfile] = pv.[KdProfile]
WHERE e.[StatusEnabled] = 1
  AND CAST(e.[KdJenisEntitas] AS INT) &lt;&gt; 1;
</sql>
