      <schema_name/>
    </partitioning>
    <connection>eis</connection>
    <sql>SELECT
    pv.[ClientName] AS [Profile_oltp],
    pv.[TglMasuk] AS [TglMasuk_oltp],
    pv.[TglKeluar] AS [TglKeluar_oltp],
    ISNULL(CAST(e.[Title] AS VARCHAR(15)), 'Tidak ada title') AS [Title_oltp],
    ISNULL(pv.[DesaKelurahan], 'Desa / kelurahan tidak diketahui') AS [DesaKelurahan_oltp],
    ISNULL(pv.[Kecamatan], 'Kecamatan tidak diketahui') AS [Kecamatan_oltp],
    ISNULL(pv.[KotaKabupaten], 'Kabupaten tidak diketahui') AS [KotaKabupaten_oltp],
    ISNULL(pv.[Provinsi], 'Provinsi tidak diketahui') AS [Provinsi_oltp],
    ISNULL(e.[Negara], 'Negara tidak diketahui') AS [Negara_oltp],
    ISNULL(e.[JenisKelamin], 'tidak ada jenis kelamin') AS [JenisKelamin_oltp],
    ISNULL(e.[StatusPerkawinan], 'Tidak ada status perkawinan') AS [StatusPerkawinan_oltp],
    ISNULL(e.[Pekerjaan], 'Tidak ada pekerjaan') AS [Pekerjaan_oltp],
    ISNULL(e.[Pendidikan], 'Tidak ada pendidikan') AS [Pendidikan_oltp],
    ISNULL(pv.[StatusVisiteProfile], '-') AS [StatusVisiteProfile],
    ISNULL(pv.[Triase], 'Tidak ada triase') AS [Triase_oltp],
    ISNULL(pv.[KelompokPasien], 'Tidak ada kelompok klien') AS [KelompokPasien_oltp],
    ISNULL(CAST(pv.[NoEntitasPenjaminPasien] AS INT), 0) AS [NoEntitasPenjaminPasien],
    ISNULL(pv.[KasusPenyakit], 'Tidak ada kasus penyakit') AS [KasusPenyakit_oltp],
    ISNULL(pv.[AsalRujukan], 'Tidak ada asal rujukan') AS [AsalRujukan_oltp],
    ISNULL(pv.[RuanganAsal], 'Tidak ada ruangan asal') AS [RuanganAsal_oltp],
    ISNULL(CAST(pv.[NoEntitasDokterPengirim] AS INT), 0) AS [NoEntitasDokterPengirim],
    ISNULL(pv.[RuanganTujuan], 'Tidak ada ruangan tujuan') AS [RuanganTujuan_oltp],
    ISNULL(pv.[StatusVisiteRuanganTujuan], '-') AS [StatusVisiteRuanganTujuan],
    ISNULL(pv.[KelasLayanan], 'Tidak ada kelas layanan') AS [KelasLayanan_oltp],
    ISNULL(pv.[KelasKamar], 'Tidak ada kelas kamar') AS [KelasKamar_oltp],
    ISNULL(pv.[KelasJaminan], 'Tidak ada kelas jaminan') AS [KelasJaminan_oltp],
    ISNULL(pv.[StatusKeluar], 'Tidak ada status keluar') AS [StatusKeluar_oltp],
    ISNULL(pv.[KondisiPulang], 'Tidak ada kondisi pulang') AS [KondisiPulang_oltp],
    ISNULL(e.[JenisEntitas], 'Entitas tidak diketahui') AS [JenisEntitas_oltp],
    ISNULL(pv.[InstalasiTujuan], 'Tidak ada departemen Tujuan') AS [InstalasiTujuan_oltp],
    ISNULL(pv.[InstalasiAsal], 'Tidak ada departemen asal') AS [InstalasiAsal_oltp],
    'kondisi pulang' AS [KondisiPulangHead],
    'jenis entitas' AS [JenisEntitasHead],
    'entitas' AS [StatusEntitasHead],
    'keluar' AS [StatusKeluarHead],
    'formal' AS [PendidikanHead],
    'pegawai' AS [PangkatHead],
    'pegawai' AS [GolonganHead],
    'jabatan' AS [KelompokJabatanHead],
    'pasien' AS [KelompokPasienHead],
    'pekerjaan' AS [PekerjaanHead],
    'perkawinan' AS [StatusPerkawinanHead],
    'suku' AS [SukuHead],
    'Jaminan' AS [KelasJaminanHead],
    'Layanan' AS [KelasLayananHead],
    'Kamar' AS [KelasKamarHead],
    'Rujukan' AS [AsalRujukanHead],
    pv.[TglSelesaiPelayanan] AS [TglSelesaiPelayanan_oltp],
    pv.[StatusEnabled],
    pv.[TglPanggilDokter] AS [TglPanggilDokter_oltp],
    pv.[TglPanggilPerawat] AS [TglPanggilPerawat_oltp],
    pv.[TglPendaftaran] AS [TglPendaftaran_oltp],
    pv.[TglPulang] AS [TglPulang_oltp]
FROM [dbo].[dlpatientvisite] pv
LEFT JOIN [dbo].[dlentity] e 
    ON e.[NoEntitas] = pv.[NoEntitas_CM] 
   AND e.[KdProfile] = pv.[KdProfile]
WHERE pv.[StatusEnabled] = 1 
  AND pv.[TglPulang] IS NOT NULL;
</sql>
