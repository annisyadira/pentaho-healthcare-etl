DROP TABLE IF EXISTS [dbo].[d_JenisKelamin];
CREATE TABLE [dbo].[d_JenisKelamin] (
    [KdJenisKelamin] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdJenisKelaminoltp] VARCHAR(10) NOT NULL,
    [NamaJenisKelamin] VARCHAR(25) NOT NULL,
    [RDNamaJenisKelamin] VARCHAR(25) NOT NULL,
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_JenisKelamin UNIQUE (KdJenisKelamin, KdProfile)
