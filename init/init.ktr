    <sql>DROP TABLE IF EXISTS [dbo].[d_Agama];
CREATE TABLE [dbo].[d_Agama] (
    [KdAgama] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdAgamaoltp] VARCHAR(10) NOT NULL,
    [NamaAgama] VARCHAR(20) NOT NULL,
    [RDNamaAgama] VARCHAR(20),
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_Agama UNIQUE (KdAgama, KdProfile)
);

DROP TABLE IF EXISTS [dbo].[d_Alamat];
CREATE TABLE [dbo].[d_Alamat] (
    [KdAlamat] INT IDENTITY(1,1) PRIMARY KEY,
    [NamaDesaKelurahan] VARCHAR(50) NOT NULL,
    [RDNamaDesaKelurahan] VARCHAR(50) NULL,
    [NamaKecamatan] VARCHAR(50) NOT NULL,
    [RDNamaKecamatan] VARCHAR(50) NULL,
    [NamaKotaKabupaten] VARCHAR(50) NOT NULL,
    [RDNamaKotaKabupaten] VARCHAR(50) NULL,
    [NamaProvinsi] VARCHAR(50) NOT NULL,
    [RDNamaProvinsi] VARCHAR(50) NULL,
    [NamaNegara] VARCHAR(50) NOT NULL,
    [RDNamaNegara] VARCHAR(50) NULL,
    [StatusEnabled] SMALLINT NOT NULL
);

DROP TABLE IF EXISTS [dbo].[d_Asal];
CREATE TABLE [dbo].[d_Asal] (
    [KdAsal] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdAsaloltp] VARCHAR(10) NOT NULL,
    [NamaAsal] VARCHAR(50) NOT NULL,
    [RDNamaAsal] VARCHAR(50) NOT NULL,
    [NamaAsalHeadL1] VARCHAR(50) NULL,
    [RDNamaAsalHeadL1] CHAR(10) NULL,
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_Asal UNIQUE (KdAsal, KdProfile)
)

DROP TABLE IF EXISTS [dbo].[d_Entitas];
CREATE TABLE [dbo].[d_Entitas] (
    [NoEntitas] INT IDENTITY(1,1) PRIMARY KEY,
    [KdProfile] SMALLINT NOT NULL,
    [NoEntitasoltp] VARCHAR(15) NOT NULL,
    [KdJenisEntitas] SMALLINT NOT NULL,
    [KdTitle] SMALLINT NOT NULL,
    [NamaLengkap] VARCHAR(150) NOT NULL,
    [TempatLahir] VARCHAR(50),
    [KdKalenderTglLahir] INT,
    [KdJenisKelamin] SMALLINT,
    [KdAgama] SMALLINT,
    [KdStatusPerkawinan] SMALLINT,
    [KdSuku] SMALLINT,
    [KdGolonganDarah] SMALLINT,
    [KdPekerjaan] SMALLINT,
    [KdStruktural] SMALLINT,
    [KdFungsional] SMALLINT,
    [KdPangkat] SMALLINT,
    [KdNegara] INT,
    [KdPendidikan] SMALLINT,
    [KdJurusan] SMALLINT,
    [KdAlamat] INT,
    [KdKategoriEntitas] SMALLINT,
    [KdStatusEntitas] SMALLINT NOT NULL,
    [StatusEnabled] INT NOT NULL
);

DROP TABLE IF EXISTS [dbo].[d_Eselon];
CREATE TABLE [dbo].[d_Eselon] (
    [KdEselon] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdEselonoltp] VARCHAR(15) NOT NULL,
    [NamaEselon] VARCHAR(30) NOT NULL,
    [RDNamaEselon] VARCHAR(30) NOT NULL,
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_Eselon UNIQUE (KdEselon, KdProfile)
);

DROP TABLE IF EXISTS [dbo].[d_Fungsional];
CREATE TABLE [dbo].[d_Fungsional] (
    [KdFungsional] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdFungsionaloltp] VARCHAR(10) NOT NULL,
    [NamaFungsional] VARCHAR(50) NOT NULL,
    [RDNamaFungsional] VARCHAR(50) NOT NULL,
    [NamaKelompok] VARCHAR(50),
    [RDNamaKelompok] VARCHAR(50),
    [NamaKelompokHeadL1] VARCHAR(50),
    [RDNamaKelompokHeadL1] VARCHAR(50),
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_Fungsional UNIQUE (KdFungsional, KdProfile)
);

DROP TABLE IF EXISTS [dbo].[d_GolonganDarah];
CREATE TABLE [dbo].[d_GolonganDarah] (
    [KdGolonganDarah] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdGolonganDaraholtp] VARCHAR(10) NOT NULL,
    [NamaGolonganDarah] VARCHAR(25) NOT NULL,
    [RDNamaGolonganDarah] VARCHAR(25),
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_GolonganDarah UNIQUE (KdGolonganDarah, KdProfile)
);

DROP TABLE IF EXISTS [dbo].[d_Hubungan];
CREATE TABLE [dbo].[d_Hubungan] (
    [KdHubungan] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdHubunganoltp] VARCHAR(10) NOT NULL,
    [NamaHubungan] VARCHAR(50) NOT NULL,
    [RDNamaHubungan] VARCHAR(50),
    [NamaHubunganHeadL1] VARCHAR(50),
    [RDNamaHubunganHeadL1] VARCHAR(50),
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_Hubungan UNIQUE (KdHubungan, KdProfile)
);

DROP TABLE IF EXISTS [dbo].[d_ICD];
CREATE TABLE [dbo].[d_ICD] (
    [KdICD] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdICDoltp] VARCHAR(10) NOT NULL,
    [NamaICD] VARCHAR(150) NOT NULL,
    [RDNamaICD] VARCHAR(150),
    [NamaKategoriICD] VARCHAR(150),
    [RDNamaKategoriICD] VARCHAR(150),
    [NamaJenisICD] VARCHAR(50),
    [RDNamaJenisICD] VARCHAR(50),
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_ICD
        UNIQUE (KdICD, KdProfile)
);

DROP TABLE IF EXISTS [dbo].[d_JenisDiagnosa];
CREATE TABLE [dbo].[d_JenisDiagnosa] (
    [KdJenisDiagnosa] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdJenisDiagnosaoltp] VARCHAR(10) NOT NULL,
    [NamaJenisDiagnosa] VARCHAR(50) NOT NULL,
