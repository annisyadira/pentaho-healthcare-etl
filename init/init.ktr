DROP TABLE IF EXISTS [dbo].[d_Jurusan];
CREATE TABLE [dbo].[d_Jurusan] (
    [KdJurusan] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdJurusanoltp] VARCHAR(15) NOT NULL,
    [NamaJurusan] VARCHAR(100) NOT NULL,
    [RDNamaJurusan] VARCHAR(100) NOT NULL,
    [NamaJurusanHeadL1] VARCHAR(100),
    [RDNamaJurusanHeadL1] VARCHAR(100),
    [StatusEnabled] SMALLINT NOT NULL,

    CONSTRAINT UQ_d_Jurusan UNIQUE (KdJurusan, KdProfile)
);

DROP TABLE IF EXISTS [dbo].[d_Kalender];
CREATE TABLE [dbo].[d_Kalender] (
    [KdKalender] INT IDENTITY(1,1) PRIMARY KEY,
    [Tanggal] DATE NOT NULL,
    [NamaHari] VARCHAR(15) NOT NULL,
    [RDNamaHari] VARCHAR(15) NOT NULL,
    [NamaBulan] VARCHAR(15) NOT NULL,
    [RDNamaBulan] VARCHAR(15) NOT NULL,
    [NamaTahun] SMALLINT NOT NULL,
    [HariKeDlmMinggu] SMALLINT NOT NULL,
    [HariKeDlmBulan] SMALLINT NOT NULL,
