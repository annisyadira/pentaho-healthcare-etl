DROP TABLE IF EXISTS [dbo].[d_JenisDokumen];
CREATE TABLE [dbo].[d_JenisDokumen] (
    [KdJenisDokumen] SMALLINT NOT NULL,
    [KdProfile] SMALLINT NOT NULL,
    [KdJenisDokumenoltp] VARCHAR(10) NOT NULL,
